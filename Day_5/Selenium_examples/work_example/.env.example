# Скопируйте этот файл в .env и подставьте логин и пароль.
# Файл .env НЕ загружается на GitHub (он указан в .gitignore).
SERVICE_ONLINE_LOGIN=ваш_логин
SERVICE_ONLINE_PASSWORD=ваш_пароль
# Поставьте 1, только если Вы согласны, чтобы тест ставил галочки согласия на обработку персональных данных и пользовательского соглашения.
SERVICE_ONLINE_ACCEPT_TERMS=0
